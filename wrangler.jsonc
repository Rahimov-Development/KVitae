{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cv.rahimov.dev",
      "zone_id": "707a2e43b0a76b0724b235419eeb8f6a",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CV_STORAGE",
      "id": "e61011d790924e0d9b6318dbb815a497"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "cv-assets"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
